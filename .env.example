# Copy to .env to override docker-compose defaults. All values here are optional;
# the app runs fully with AWS features mocked if you set nothing.

# --- Database (defaults are fine for local) ---
# POSTGRES_DATABASE=expense_tracker
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres

# --- App ---
# Generate one with: openssl rand -hex 32
# PLAY_APPLICATION_SECRET=change-me
# Where the web app is served (baked into the frontend bundle at build time).
# Change host/port here AND in the web "ports" mapping if you don't use :8080.
# API_URL=http://localhost:8080/api

# --- AWS-backed features --------------------------------------------------------------
# Each mode is "mock" (default, no AWS calls) or "real". Set to real + fill creds to enable.
# TEXTRACT_MODE=real     # receipt OCR (AWS Textract)
# BEDROCK_MODE=real      # bank-statement extraction (Amazon Bedrock)
# BDA_MODE=real          # statement-extraction fallback (Bedrock Data Automation)

# Shared AWS credentials + resources (used by Textract and S3 document storage).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=your-bucket
# AWS_S3_ENDPOINT_OVERRIDE=        # e.g. http://localstack:4566 for local S3

# Bedrock (can reuse the AWS creds above, or set dedicated ones).
# BEDROCK_REGION=us-east-1
# BEDROCK_ACCESS_KEY_ID=
# BEDROCK_SECRET_ACCESS_KEY=

# Bedrock Data Automation (needs a profile + project/blueprint ARNs and an output bucket).
# BDA_PROFILE_ARN=
# BDA_STANDARD_PROJECT_ARN=
# BDA_BANK_STATEMENT_BLUEPRINT_ARN=
# BDA_OUTPUT_S3_URI=s3://your-bucket/bda-output

# --- JEV --------------------------------------------------------------------------------
# Bank-statement row category/merchant suggestions. "mock" (default) makes placeholder picks,
# not real predictions; set to real + an API key to get real suggestions.
# JEV_MODE=real
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest