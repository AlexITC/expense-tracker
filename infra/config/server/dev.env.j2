POSTGRES_DATABASE="server_db"
POSTGRES_USERNAME="db_user"
POSTGRES_PASSWORD="REPLACE_ME"
POSTGRES_HOST="127.0.0.1"

PLAY_APPLICATION_SECRET="REPLACE_ME"
JWT_SECRET="REPLACE_ME"
JWT_ENFORCED=false

PLAY_SESSION_SECURE=true
PLAY_SESSION_DOMAIN="{{ web_app_domain }}"

APP_ALLOWED_HOST_1="{{ web_app_domain }}"
APP_ALLOWED_HOST_2="{{ admin_app_domain }}"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"

# Receipt OCR via AWS Textract. "real" calls AWS; anything else uses the mock.
TEXTRACT_MODE="mock"

# Bank-statement mapping generation via AWS Bedrock (Nova Pro). "real" calls AWS Bedrock Converse;
# otherwise a hardcoded mapping is returned (no AWS call), which never parses real statements.
# The credentials' IAM principal needs bedrock:InvokeModel for the configured model.
BEDROCK_MODE="mock"
BEDROCK_ACCESS_KEY_ID="REPLACE_ME"
BEDROCK_SECRET_ACCESS_KEY="REPLACE_ME"

# Bank-statement row category/merchant suggestions via JEV. "real" calls the JEV API; otherwise the
# mock makes placeholder picks (not real predictions).
JEV_MODE="mock"
JEV_API_KEY="REPLACE_ME"

EMAIL_SENDER_ADDRESS="template@wiringbits.net"

WEBAPP_HOST="https://template-demo.wiringbits.net"

USER_TOKENS_HMAC_SECRET="REPLACE_ME"
