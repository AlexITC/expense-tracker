@startuml
Title Wiringbits Scala WebApp Template - Infrastructure Diagram

skinparam {
    ArrowColor Red
    linetype ortho
}

cloud Cloud {
    database Postgres
    rectangle UbuntuServer {
        node ScalaServerApp
        node nginx

        folder FileSystem {
            file WebAssets
        }
    }

    component EmailService
    ScalaServerApp -> EmailService
    nginx -> WebAssets
    nginx --> ScalaServerApp
    ScalaServerApp --> Postgres
}

person RegularUser

RegularUser -> nginx
@enduml